{
    "name": "emmanuelsaleem/laravel-stripe-manager",
    "description": "Complete Laravel Stripe management package with UI for customers, products, subscriptions and payments",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "stripe", "subscriptions", "payments", "billing", "saas"],
    "homepage": "https://github.com/emmanuelsaleem/laravel-stripe-manager",
    "support": {
        "email": "emmanuelsaleem098765@gmail.com",
        "source": "https://github.com/emmanuelsaleem/laravel-stripe-manager"
    },
    "authors": [
        {
            "name": "Emmanuel Saleem",
            "email": "emmanuelsaleem098765@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0|^10.0|^11.0",
        "laravel/cashier": "^13.0|^14.0|^15.0",
        "stripe/stripe-php": "^10.0|^11.0|^12.0|^13.0|^14.0|^15.0|^16.0",
        "illuminate/support": "^9.0|^10.0|^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "EmmanuelSaleem\\LaravelStripeManager\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EmmanuelSaleem\\LaravelStripeManager\\StripeManagerServiceProvider"
            ]
        }
    }
}